% Publications: one file shared by the LaTeX CV (biblatex, chem-acs) and the
% al-folio website (jekyll-scholar). Each tool ignores the other's fields.
%
%   author+an = {N=highlight}   CV/resume: bold the N-th author (your own name);
%                               add "corresponding" for a * mark, e.g.
%                               {1=highlight; 2=corresponding}
%   keywords = {preprint}       listed under Preprints (CV and website; the section
%                               only appears when such an entry exists)
%   keywords = {inprep}         listed under Manuscripts in Preparation (same rule);
%                               use @unpublished with the target in `note`
%   preprint = {DOI}            website only: "Preprint" button on a published paper
%                               (once a preprint is published, drop its entry and
%                               move its DOI here)
%   selected = {true}           resume + website home page (the full CV lists all)
%   google_scholar_id = {...}   website only: Scholar citation badge (the part after
%                               ':' in the paper's citation_for_view link)
%   abbr, bibtex_show           website only: venue badge, "Bib" button
%   award, award_name           website only: award button and its text
%                               (see docs/CUSTOMIZE.md)
% Keep entries newest first: the CV and the website print them in file order.

